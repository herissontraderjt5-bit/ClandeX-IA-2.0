# GEMINI_API_KEY: Required for Gemini AI real-time voice and technical commentary.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_LIVE_MODEL="gemini-3.8-live"
GEMINI_MODEL="gemini-3.8-flash"
VITE_GEMINI_LIVE_MODEL="gemini-3.8-live"
VITE_GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: Host URL for ClandeX-IA web application
APP_URL="MY_APP_URL"

# SUPABASE DATABASE & REALTIME (https://qxojtaqselrgitdmmora.supabase.co)
# Obtenha sua Anon Key no painel Supabase: Project Settings > API > Project API keys > anon public
VITE_SUPABASE_URL="https://qxojtaqselrgitdmmora.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Backend server Supabase configuration (opcional)
SUPABASE_URL="https://qxojtaqselrgitdmmora.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
